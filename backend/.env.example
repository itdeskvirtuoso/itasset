# Copy to backend/.env for local development. On Vercel, add the same keys under
# Project Settings -> Environment Variables. Never commit real values.

# MongoDB Atlas connection string (use a NEW password after rotating the old leaked one)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/assetdata

# Random secret, 32+ characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Only needed once, when the database has no Super Admin: creates user "admin" with this
# password (12+ characters). Remove it again after the first start.
ADMIN_INITIAL_PASSWORD=

# Extra origins allowed to call the API from a browser, comma separated (optional)
CORS_ORIGINS=

PORT=5000
